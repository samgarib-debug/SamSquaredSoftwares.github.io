{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "samsquared-leads",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",

  // Only /api/* reaches the Worker. Every other path still goes to GitHub
  // Pages through the Cloudflare proxy, so the site itself is untouched.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "samsquaredsoftwares.com/api/*", "zone_name": "samsquaredsoftwares.com" },
    { "pattern": "www.samsquaredsoftwares.com/api/*", "zone_name": "samsquaredsoftwares.com" }
  ],

  // No account_id or database_id on purpose: the deploy token decides the
  // account, and wrangler finds (or the deploy workflow creates) the database
  // by name.
  "d1_databases": [
    { "binding": "DB", "database_name": "samsquared-leads", "migrations_dir": "migrations" }
  ],

  // Per IP, per Cloudflare location. Abuse damping, not an exact quota.
  // period must be 10 or 60.
  "ratelimits": [
    { "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  "vars": {
    "ALLOWED_ORIGINS": "https://samsquaredsoftwares.com,https://www.samsquaredsoftwares.com"
  },

  // Optional secrets: SLACK_WEBHOOK_URL and HUBSPOT_TOKEN
  // (wrangler secret put <NAME>; see README.md). Optional vars for HubSpot:
  // HUBSPOT_DEAL_STAGE and HUBSPOT_PIPELINE, to skip the pipeline lookup.

  // Keep only the Worker's own JSON log lines (event, row id, country).
  // Invocation logs and traces would record each visitor's user agent, city
  // and network next to their lead, and traces would record the Slack webhook
  // URL, which is a secret.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
